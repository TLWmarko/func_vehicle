//
// func_vehicle mod
//

@baseClass = PhysParticleKeys
[
	part_mass(float) : "Particle mass" : : "Share of the vehicle's mass at this point. Negative values pin the particle in place. Default 1"
	physobj_stepup(float) : "Step-up height" : : "Stair step-up, similar to how the player walks up stairs. Default 0"
	physobj_friction_water(string) : "Directional water friction" : : "Default 2 2 2"
	physobj_bounce(float) : "Bounce" : : "1 no bounce, 2 perfectly bouncy. Default 1.025"
	physobj_buoyancy(float) : "Buoyancy" : : "Gravity multiplier under water. Default -0.75"
]

@baseClass base(PhysParticleKeys) = PhysWheelKeys
[
	netname(choices) : "Wheel" : : "A vehicle needs all four wheels. The ones called front* will steer the vehicle, by default back* wheels are powered" =
	[
		"frontleft" : "Steering left wheel"
		"frontright" : "Steering right wheel"
		"backleft" : "Powered left wheel"
		"backright" : "Powered right wheel"
	]
	physobj_flags(flags) =
	[
		1024 : "Powered, drives the vehicle. If none are marked as powered, back* wheels act as powered" : 0
	]
	wheel_offset(float) : "Visual depth offset" : : "Moves the visible wheel along its axle, positive away from the vehicle, negative towards it"
	relative_size(float) : "Radius" : : "Wheel radius. Defaults to 14 on MDL models, brush radius for bmodels"
	physobj_spring_length(float) : "Spring length" : : "How far the spring can extend. Default 12"
	physobj_spring_force(string) : "Spring force" : : "Force (multiplied by gravity) when fully extended, fully compressed, damping. Default 0 7.5 0.07"
	physobj_friction_ground(string) : "Ground friction" : : "Rolling friction forwards, grip sideways, extra sideways grip at high speed. Default 200 1000 4.4"
]

@PointClass base(Angle) size(-8 -8 -8, 8 8 8) color(255 128 0) = func_vehicle : "Place in the center of a vehicle.

This is the entity which brings all the disjointed particles, statics and hitmodels together for a fully simulated vehicle.

When building a vehicle out of brushes, it is recommended to build vehicles facing along +-Y (angle 90 or 270) so their wheels spin smoothly, alternatively use func_template_models for wheels.

I'm keeping the titular name for the memes, but this is a point entity :)"
[
	phys_particle_target(target_destination) : "Particles and wheels" : : "Targetname of all its particles and wheels, required"
	phys_static_target(target_destination) : "Statics" : : "Targetname of all its statics"
	phys_hitmodel_target(target_destination) : "Hitmodels" : : "Targetname of all its hitmodels"
	target(target_destination) : "Start position" : : "Optional info_notnull to teleport to at start, and its angle sets which way the vehicle faces"
	spawnflags(flags) =
	[
		1 : "No roof" : 0
		2 : "Permanent gun" : 0
		4 : "Tank" : 0
	]
	physobj_mass(float) : "Vehicle Mass" : : "Total mass of the vehicle. Default 1000"
	max_forward_speed(float) : "Top speed" : : "Default 950, tanks 350"
	max_reverse_speed(float) : "Top speed in reverse" : : "Default 800, tanks 350"
	accelerate_forward(float) : "Acceleration" : : "Default 3000, tanks 2500"
	accelerate_reverse(float) : "Acceleration in reverse" : : "Default 2500"
	max_turn(float) : "Max steering angle" : : "Default 35, negative steers other way. Tanks: speed multiplier for the inner side, default 0.75"
	turn_speed(float) : "Steering speed" : : "Degrees per second, default 125. Tanks: acceleration multiplier for the inner side, default 0.4"
	max_roll_speed(float) : "Air roll speed" : : "How fast the driver can roll the vehicle in the air. Default 350"
	accelerate_roll(float) : "Air roll acceleration" : : "How hard the driver can roll the vehicle in the air. Default 2000"
	physobj_friction_logic_mult(string) : "Coasting friction" : : "Wheel friction multiplier when not accelerating. Default 2 1 1"
	physobj_friction_braking_mult(string) : "Braking friction" : : "Wheel friction multiplier while braking. Default 22.25 1 1, tanks 10 1 1"
	lip(float) : "Camera height" : : "Offset for the camera above the wheels. Default 16"
	chase_settings(string) : "Camera" : : "Camera distance behind & above. Default 150 0 50"
	autolevel_maxangle(string) : "Auto-level limits" : : "Set to non-zero to make the vehicle right itself instead of allowing the driver rolling it, e.g. 35 20 0"
	autolevel_force(string) : "Auto-level force" : : "Auto-leveling strength, e.g. 1 5 0"
]

@PointClass base(Targetname, PhysParticleKeys) size(-4 -4 -4, 4 4 4) color(255 200 0) studio(model) = phys_particle : "Physics particle, a point of a vehicle's collision shape"
[
	relative_size(float) : "Size" : : "How far it stays away from floors. Default 0, a point"
	physobj_friction_ground(string) : "Ground friction" : : "Forwards, sideways, extra sideways grip at high speed. Default 400 400 0"
	model(studio) : "Model" : : "Optional model shown at the particle"
]

@PointClass base(Targetname, PhysWheelKeys) size(-4 -4 -4, 4 4 4) color(255 200 0) studio(model) = phys_wheel : "Vehicle wheel using a model. A point of a vehicle's collision shape, with wheel properties."
