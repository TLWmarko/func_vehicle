		"rightdoor" : "Exit: right door"
		"topexit" : "Exit: top"
		"botexit" : "Exit: bottom"
		"frontexit" : "Exit: front"
		"backexit" : "Exit: back"
		"turretbase" : "Turret base"
		"turretswivel" : "Turret swivel, turns sideways"
		"turretbody" : "Turret body, tilts up and down"
		"turretbarrel" : "Turret barrel, spins while shooting"
	]
	solid(choices) : "Enter here" : : "Entrances: players can get in standing close to this" =
	[
		0 : "No"
		1 : "Yes"
	]
]

